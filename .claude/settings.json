{
  "permissions": {
    "deny": [
      "Read(./.intellijPlatform/**)",
      "Read(./.gradle/**)",
      "Read(./.kotlin/**)",
      "Read(./build/**)",
      "Read(./.idea/**)",
      "Read(./gradle/wrapper/gradle-wrapper.jar)",
      "Read(./**/*.jar)",
      "Read(./**/*.class)",
      "Read(./**/*.log)"
    ],
    "allow": [
      "Bash(./gradlew runIde:*)",
      "Bash(jcmd:*)",
      "Bash(jfr:*)",
      "Bash(jps:*)",
      "Read(build/idea-sandbox/**)"
    ]
  }
}
