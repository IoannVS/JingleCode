<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>io.github.ioannvs.jinglecode</id>
    <name>Jingle Code</name>
    <vendor url="https://github.com/IoannVS">IoannVS</vendor>

    <description><![CDATA[
        Pixel-art winter decorations for JetBrains IDEs that sit on the real edges of the interface:
        a garland in the gaps between panels, icicles under the toolbar, a fireplace in the status bar,
        falling snow and a small village along the bottom of the editor, a snowman under the Project tree,
        a railway in the bottom tool windows and Santa's yard in the right ones.
        The garland, icicles and Santa's elves react to runs, tests and builds.<br>
        Everything switches on in December and puts itself away after January 14.
        Snow and the village have a button in the editor corner, and every part can be turned off
        in Settings | Appearance | Jingle Code. Animation pauses when the IDE is inactive, in Power Save
        and in Presentation mode.
        ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- Git events (gifts for commits); without Git the plugin works, the gifts just stay put. -->
    <depends optional="true" config-file="jingle-code-git.xml">Git4Idea</depends>
    <!-- The Build action (builds without a run configuration); run configurations are heard in every IDE. -->
    <depends optional="true" config-file="jingle-code-lang.xml">com.intellij.modules.lang</depends>

    <resource-bundle>messages.JingleCodeBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>

        <applicationConfigurable
                parentId="appearance"
                id="io.github.ioannvs.jinglecode.settings"
                instance="io.github.ioannvs.jinglecode.settings.JingleCodeConfigurable"
                bundle="messages.JingleCodeBundle"
                key="settings.display.name"/>
        <postStartupActivity implementation="io.github.ioannvs.jinglecode.overlay.FrameOverlayStartupActivity"/>
        <postStartupActivity implementation="io.github.ioannvs.jinglecode.popups.PopupSnowStartupActivity"/>
        <postStartupActivity implementation="io.github.ioannvs.jinglecode.railway.RailwayStartupActivity"/>
        <editorFactoryListener implementation="io.github.ioannvs.jinglecode.snow.EditorSnowListener"/>
        <editorFactoryListener implementation="io.github.ioannvs.jinglecode.village.EditorVillageListener"/>
        <iw.actionProvider implementation="io.github.ioannvs.jinglecode.snow.EditorSnowWidgetActionProvider"/>
        <statusBarWidgetFactory id="JingleCode.Fireplace"
                                implementation="io.github.ioannvs.jinglecode.fireplace.FireplaceWidgetFactory"
                                order="last"/>
    </extensions>

    <projectListeners>
        <listener class="io.github.ioannvs.jinglecode.drift.GiftPileListener"
                  topic="io.github.ioannvs.jinglecode.events.JingleEventListener"/>
        <listener class="io.github.ioannvs.jinglecode.garland.RunLightsListener"
                  topic="io.github.ioannvs.jinglecode.events.JingleEventListener"/>
        <listener class="io.github.ioannvs.jinglecode.icicles.IcicleFallsListener"
                  topic="io.github.ioannvs.jinglecode.events.JingleEventListener"/>
        <listener class="io.github.ioannvs.jinglecode.fireworks.FireworksListener"
                  topic="io.github.ioannvs.jinglecode.events.JingleEventListener"/>
        <listener class="io.github.ioannvs.jinglecode.yard.YardEventsListener"
                  topic="io.github.ioannvs.jinglecode.events.JingleEventListener"/>
        <listener class="io.github.ioannvs.jinglecode.runs.RunWatcher"
                  topic="com.intellij.execution.ExecutionListener"/>
        <listener class="io.github.ioannvs.jinglecode.snow.CommitTitleButton"
                  topic="com.intellij.openapi.wm.ex.ToolWindowManagerListener"/>
        <listener class="io.github.ioannvs.jinglecode.railway.RailwayToolWindowListener"
                  topic="com.intellij.openapi.wm.ex.ToolWindowManagerListener"/>
        <listener class="io.github.ioannvs.jinglecode.yard.YardTitleButtons"
                  topic="com.intellij.openapi.wm.ex.ToolWindowManagerListener"/>
        <listener class="io.github.ioannvs.jinglecode.railway.RailwayTitleButtons"
                  topic="com.intellij.openapi.wm.ex.ToolWindowManagerListener"/>
    </projectListeners>

    <actions>
        <action id="JingleCode.ToggleEditorSnow"
                class="io.github.ioannvs.jinglecode.snow.ToggleEditorSnowAction"
                icon="/icons/snowflake.svg"/>
        <action id="JingleCode.TogglePanelSnow"
                class="io.github.ioannvs.jinglecode.snow.TogglePanelSnowAction"
                icon="/icons/snow_snowman.svg">
            <add-to-group group-id="ProjectViewToolbar" anchor="last"/>
        </action>
        <action id="JingleCode.ToggleYardDecor"
                class="io.github.ioannvs.jinglecode.yard.ToggleYardDecorAction"
                icon="/icons/snow_santa.svg"/>
        <action id="JingleCode.ToggleRailwayDecor"
                class="io.github.ioannvs.jinglecode.railway.ToggleRailwayDecorAction"
                icon="/icons/snow_locomotive.svg"/>
    </actions>
</idea-plugin>
